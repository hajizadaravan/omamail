[Unit]
Description=Omamail new-mail notifications
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/.local/lib/omamail/omamail watch
Restart=on-failure
RestartSec=30
# 2 = not signed in yet, 3 = password rejected: retrying will not help.
RestartPreventExitStatus=2 3

[Install]
WantedBy=graphical-session.target
